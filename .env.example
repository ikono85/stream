# Copiez ce fichier en .env et renseignez votre clé.
# Elle se crée sur https://heiwastream.fr/api?p=cle, avec un compte Discord.
HEIWA_KEY=hs_votre_cle_ici

# Fiches détaillées rassemblées par page de catalogue (défaut 24).
HEIWA_RICH=24

# À 1, désactive le cache disque (.cache/heiwa.json).
# HEIWA_NO_CACHE=1

# ---------- Administration ----------
# Empreinte du mot de passe, produite par : npm run admin:motdepasse
# Sans elle, /admin n'est accessible que depuis la machine qui fait tourner
# le serveur. C'est suffisant en développement, pas pour un site en ligne.
# ADMIN_MOTDEPASSE=scrypt$...$...

# À 0, même la machine locale doit saisir le mot de passe.
# ADMIN_LOCALHOST=0

# À 1 derrière un proxy inverse (Caddy, nginx) : la vraie adresse du
# visiteur est alors lue dans X-Forwarded-For pour le journal. Ne l'activez
# que si un proxy est réellement devant, sinon l'en-tête est falsifiable.
# ADMIN_DERRIERE_PROXY=1

# Secret de signature des sessions. Par défaut il est dérivé de l'empreinte
# ci-dessus, ce qui invalide les sessions quand le mot de passe change.
# ADMIN_SECRET=

# ---------- Comptes et suivi d'usage ----------
# Secret de signature des sessions des membres. Par défaut il est créé au
# premier démarrage dans donnees/secret.txt. Le supprimer déconnecte tout
# le monde, ce qui est la façon la plus simple de le faire.
# SESSION_SECRET=

# Durée de conservation du journal d'usage, en jours. Absent ou à 0 :
# rien n'est effacé. Le mécanisme est en place pour pouvoir l'activer
# plus tard sans rien migrer.
# RETENTION_JOURS=90
